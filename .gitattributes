# --- Line endings -------------------------------------------------------------------
# FIRST, BEFORE the LFS section: the last matching rule wins, so a `* text=auto` placed after
# the LFS lines would override their `-text` and corrupt the binaries.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md  text
# Git hooks run under sh: LF, whatever the platform.
bin/harness/hooks/* text eol=lf

# --- Git LFS: heavy binaries never go into the git history -------------------------
# Declare a NEW binary type HERE, BEFORE committing it (a binary enters the history forever).
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.zip    filter=lfs diff=lfs merge=lfs -text

# --- Several duos: files where everyone only APPENDS: union merge, no conflict --------
# (both sides kept; a conflict on these stopped a duo for nothing)
pipeline/owner.md      merge=union
docs/INTERVENTIONS.md  merge=union
docs/UPSTREAM.md       merge=union
docs/journal/*.md      merge=union
