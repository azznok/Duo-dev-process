{
  "permissions": {
    "deny": [
  "Read(./.mcp.json)", "Read(**/.env)", "Read(**/.env.*)",
  "Edit(./.mcp.json)", "Edit(**/.env)", "Edit(**/.env.*)",
  "Edit(./.state/**)",
  "Edit(./.claude/settings.json)",
  "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)",
  "Bash(git push --mirror:*)", "Bash(git push --delete:*)", "Bash(git push -d:*)",
  "Bash(git push origin --delete:*)", "Bash(git push origin --force:*)", "Bash(git push origin -f:*)",
  "Bash(git remote add:*)", "Bash(git remote remove:*)", "Bash(git remote set-url:*)",
  "Bash(git reset --hard:*)", "Bash(git clean:*)",
  "Bash(git filter-branch:*)", "Bash(git filter-repo:*)", "Bash(git update-ref -d:*)",
  "Bash(gh repo delete:*)",
  "Bash(rm -rf .git:*)", "Bash(rm -rf ./.git:*)", "Bash(rm -rf ~:*)", "Bash(rm -rf /:*)"
]
  },
  "enabledMcpjsonServers": [],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,pathlib; p=pathlib.Path(os.environ.get('CLAUDE_PROJECT_DIR','.'))/'.state'; os.environ.get('HARNESS_ROLE')=='coder' and (p.mkdir(exist_ok=True) or (p/'heartbeat').touch())\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
