# Project configuration. Copied to config/project.env and filled by the ONBOARDING (supervisor
# session, supervisor/ONBOARDING.md), which then sets ONBOARDED=1.
# NO SECRET HERE. Keys (NTFY_TOPIC, MESHY_API_KEY, ELEVENLABS_API_KEY) live in the Windows User
# environment variables; versioned files only carry their NAME (${MESHY_API_KEY}).
# Format: KEY=value, one per line, no quotes. Relative paths start at the repo root (the root is
# deduced from the scripts' location, never written here).
# One-off override for ONE run: environment variable HARNESS_<KEY> (e.g. HARNESS_REVIEWER_EFFORT=high);
# the value "empty" clears the key.

# --- The project ----------------------------------------------------------------
# Short name: notification titles, process name of the app (stop-all), window titles.
PROJECT=myproject
# Language of the docs and of the exchanges with the owner (code and commits stay English).
LANGUAGE=en
# Set to 1 by the supervisor at the end of the onboarding (the doctor checks it).
ONBOARDED=0

# --- The stack --------------------------------------------------------------------
# none = no adapter: the coder runs the build tools itself, inside its turn.
# <name> = bin/harness/lib/stacks/<name>.ps1 (a long-running editor, emulator, dev server...):
#          interface in bin/harness/lib/stacks/README.md.
STACK=none
# Name of the env var that points a duo at ITS OWN build folder (config/duos.txt, 3rd column):
# two duos building in one folder lock each other's files. Examples: CARGO_TARGET_DIR (Rust),
# none needed for most JS/Python stacks. Empty = none.
BUILD_DIR_ENV=

# --- The Claude CLI --------------------------------------------------------------
# Empty = automatic detection (npm, .local\bin, PATH): the PATH of a parent shell is not reliable.
CLAUDE_CLI=

# --- Models (tiers of the task line MODEL: top|default|mid|small) ------------------
# "default" = CODER_MODEL.
MODEL_TOP=claude-fable-5-1
MODEL_MID=claude-sonnet-5-5
MODEL_SMALL=claude-haiku-5-5

# --- The coder (implementer + QA) -------------------------------------------------
CODER_MODEL=claude-opus-5-5
CODER_FALLBACK=claude-fable-5-1
CODER_EFFORT=medium
# Effort of the fix of a rejected "default" task (a second rejection moves to MODEL_TOP).
CODER_EFFORT_REJECTED=high
# Settings sources loaded by the coder (empty = CLI default). project,local: neither the user's
# plugins nor hooks -> fewer tokens on every call.
CODER_SETTING_SOURCES=project,local
# Nudges after a stop WITHOUT a report. Most nudges only re-read the context to answer "done".
MAX_NUDGES=1
# "Wait for your benches" nudges when benches are still running at the end of the turn.
MAX_WAITS=3
# Auto-compaction window (tokens): ~200k keeps every call affordable.
COMPACT_WINDOW=200000
# Hours after which a resume of the SAME task starts cold anyway.
RESUME_MAX_H=12

# --- The reviewer (architect + reviewer) -------------------------------------------
REVIEWER_MODEL=claude-opus-5-5
REVIEWER_EFFORT=medium
# Escalation ONLY to judge visual proofs. One credit exhausted: the other model, same effort.
REVIEWER_ESCALATION=claude-fable-5-1
REVIEWER_EFFORT_VISUAL=high
REVIEWER_SETTING_SOURCES=project
# Rejections in a row on one branch before it is set aside (kept, not merged) and a question asked.
REJECT_MAX=3
# Lines of code diff put in the reviewer's packet (the rest: git diff).
DIFF_MAX_LINES=400
# Size caps of the pipeline files (KB): a long report hides the one line that matters.
REPORT_MAX_KB=6
TASK_MAX_KB=5

# --- Rhythm of the duo loop ---------------------------------------------------------
# After TASK: NONE the reviewer runs again only if HEAD, docs/PLAN.md, pipeline/owner.md or
# pipeline/lane.txt change. Check every N seconds (no model call while asleep).
POLL_IDLE_S=300
# This duo's name ("" = single duo). Set by the orchestrator (HARNESS_DUO), not here.
DUO=
# Usage limit on a model: closed until the announced reset (+ margin), else a new try every N
# minutes; meanwhile the role switches to the next model of its chain.
QUOTA_PROBE_MIN=15
QUOTA_MARGIN_MIN=2
# Orchestrator disk alert (GB free on the duos' drive).
DISK_MIN_GB=60

# --- The verification gate (bin/harness/lib/gate.ps1) -------------------------------
# The HARNESS, not the coder, runs these after each task; the reviewer reads the result.
# ";"-separated, each run by cmd.exe from the repo root. Filled at onboarding. Examples:
#   Rust:   cargo fmt --all --check;cargo clippy --workspace --all-targets -- -D warnings;cargo test --workspace
#   Node:   npm run lint;npm run typecheck;npm test
#   Python: ruff check .;mypy src;pytest -q
GATE_CMDS=
GATE_TIMEOUT_S=2400
# Gate commands matching this regex wait for the OTHER duo's heavy build and run under the shared
# "suite" lock: two test suites at once exceed their timeouts.
GATE_HEAVY_MATCH=test
# Process names of the other duo's heavy build to wait for, e.g. ^(cargo|rustc)\.exe$ or ^node\.exe$.
# Empty = never wait.
HEAVY_PROCESS_REGEX=
# Every .ps1 parses, every .sh passes bash -n, every .py compiles (always run).
GATE_LINT_HARNESS_CMD=bash bin/benches/harness_lint.sh
# Visual tests (golden images, input scenarios in a window); skipped when only docs changed.
GATE_VISUAL_CMD=
GATE_VISUAL_TIMEOUT_S=1800
# Benchmarks compared with the task base ({BASE}). Empty by default: they run at the END OF A
# MILESTONE, machine idle (per-task benchmarks on a busy machine were noise).
GATE_BENCH_CMD=
GATE_BENCH_TIMEOUT_S=3600
# 1 = benchmarks in the background during the reviewer's pass (verdict in pipeline/bench.md).
GATE_BENCH_BACKGROUND=1
# End-of-milestone gate: benchmarks against the previous milestone end ({BASE_MILESTONE}), then
# the load test ({MILESTONE}). Background commands (GATE_BENCH_CMD with GATE_BENCH_BACKGROUND=1,
# BACKGROUND_LOAD_CMD) also get {HEAD} {TASK} {OUT} {HEAVY}.
MILESTONE_BENCH_CMD=
MILESTONE_LOAD_CMD=
LOAD_TIMEOUT_S=3600
# Load test on NEW seeds during the reviewer's pass (verdict in pipeline/load.md); off = disabled.
BACKGROUND_LOAD_CMD=off
# Paths that count as tests (the gate lists every MODIFIED or REMOVED test for the reviewer).
TEST_PATH_REGEX=(^|/)(tests?|__tests__|spec)/|[._-](test|spec)s?\.[a-z]+$|^tests/golden/|^scenarios/
# Owner-only docs: the gate fails if a task touches them; the mediator never touches them.
PROTECTED_DOCS=docs/VISION.md;docs/PROJECT-RULES.md

# --- MCP on demand ------------------------------------------------------------------
# DOMAINS value -> servers of .mcp.json given to the coder (";" between domains). Every MCP
# server costs its tool definitions on EVERY model call: only where needed.
MCP_BY_DOMAIN=3d:blender,meshy
# The Blender bridge (DOMAINS 3d only).
BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
BLENDER_PORT=9876

# --- Paid generation (tools/gen) -------------------------------------------------------
# Credit cap per command (above: refused, even with --pay).
GEN_CAP_MESHY=100
GEN_CAP_ELEVEN=4000
