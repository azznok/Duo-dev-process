pipeline/.in_progress
pipeline/.snapshots/
pipeline/history/
# pipeline/owner.md, the templates and pipeline/README.md ARE tracked.

# --- Proofs of work (traces, not sources; a reference to keep goes to tests/golden/ or docs/art/) ---
proofs/

# --- Deliverables (regenerable) ---
/build/

# --- Build outputs of common stacks (uncomment yours at onboarding) ---
# target/            # Rust / cargo
# node_modules/      # Node
# dist/              # JS bundlers, Python wheels
# .venv/             # Python virtual env
# bin/Debug/ bin/Release/ obj/   # .NET (careful: never ignore the harness's bin/)
# Library/ Temp/ Obj/            # Unity
# Binaries/ Intermediate/ Saved/ DerivedDataCache/   # Unreal

